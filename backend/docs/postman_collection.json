{
  "info": {
    "_postman_id": "step-quiz-backend",
    "name": "STEPQ Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Trial",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Example QGroup\",\n  \"passphrase\": \"ok\",\n  \"userId\": \"00000000-0000-0000-0000-000000000001\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/trial", "host": ["{{baseUrl}}"], "path": ["api","trial"] }
      }
    },
    {
      "name": "Post Answer",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"trialId\": \"00000000-0000-0000-0000-000000000002\",\n  \"questionId\": \"00000000-0000-0000-0000-000000000003\",\n  \"answer\": \"A\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/answer", "host": ["{{baseUrl}}"], "path": ["api","answer"] }
      }
    },
    {
      "name": "Update Answer",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"score\": 5,\n  \"scoringStatus\": \"scored\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/answer/{{answerId}}", "host": ["{{baseUrl}}"], "path": ["api","answer","{{answerId}}"] }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "answerId", "value": "00000000-0000-0000-0000-000000000004" }
  ]
}
